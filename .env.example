# ===== AI "Desain dari foto" =====
# Salin file ini menjadi .env lalu isi key-nya. Jalankan ulang `npm run dev` setelah mengubah .env.
# PERHATIAN: variabel VITE_* ikut tertanam di hasil build, jadi bisa dilihat siapa pun yang membuka situsnya.

# Key Gemini gratis (https://aistudio.google.com/app/apikey). Boleh beberapa, pisahkan koma:
# bila limit satu key habis, otomatis dipakai key berikutnya.
VITE_GEMINI_KEYS="AIza...key1,AIza...key2"

# Cadangan bila Gemini gagal / hasil kurang sesuai (opsional, gratis)
# https://console.groq.com/keys
VITE_GROQ_KEY=""
# https://openrouter.ai/settings/keys (model berakhiran :free)
VITE_OPENROUTER_KEY=""

# Daftar model, dicoba berurutan (opsional; kosongkan untuk bawaan)
# VITE_GEMINI_MODELS="gemini-flash-latest,gemini-2.5-flash,gemini-flash-lite-latest"
# VITE_GROQ_MODELS="meta-llama/llama-4-scout-17b-16e-instruct"
# VITE_OPENROUTER_MODELS="google/gemma-3-27b-it:free,qwen/qwen2.5-vl-72b-instruct:free"

# ===== Lainnya =====
# GEMINI_API_KEY / APP_URL: disuntik otomatis bila dijalankan di AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
